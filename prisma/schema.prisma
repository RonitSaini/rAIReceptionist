// FrontDesk AI — Prisma schema
// All DateTime columns are stored in UTC. Display in Account.timeZone.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (-pooler) for the app
  directUrl = env("DIRECT_URL") // unpooled, used by prisma db push / migrate
}

// ---------- Auth ----------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String? // null for Google-only users
  googleId      String?   @unique
  emailVerified DateTime?
  image         String?
  accountId     String?
  account       Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  termsAcceptances TermsAcceptance[]

  @@index([accountId])
}

/// The record produced during a dispute: who agreed to which version of /terms, when, from where.
/// One row per user per version — re-accepting the same version keeps the FIRST timestamp, and a
/// material terms change re-prompts by bumping TERMS_VERSION (src/app/terms/terms-version.ts).
model TermsAcceptance {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  termsVersion String
  acceptedAt   DateTime @default(now())
  ipAddress    String?

  @@unique([userId, termsVersion])
}

// ---------- Business account ----------

enum SubscriptionStatus {
  none
  trialing
  active
  past_due
  cancelled
}

/// The profession an account answers the phone for. Every value maps to exactly one archetype
/// in src/verticals: restaurant; field_service (plumbing, hvac, electrical, roofing, locksmith,
/// towing); shop_appointment (auto_repair, veterinary); property_management.
///
/// Chosen at sign-up and locked once onboarding step 2 is complete: the data shapes differ per
/// archetype and switching would orphan an account's bookings. Only an admin path may change it.
enum Vertical {
  restaurant
  plumbing
  hvac
  electrical
  roofing
  locksmith
  towing
  auto_repair
  veterinary
  property_management
}

model Account {
  id String @id @default(cuid())

  /// Which profession this account is. Drives vocabulary, onboarding steps, dashboard modules,
  /// the agent's prompt and functions — see src/verticals. Existing rows were backfilled to
  /// `restaurant`, which is also the default so a row can never exist without one.
  vertical Vertical @default(restaurant)

  /// The trading name, for every vertical. The column is still called `restaurantName` because
  /// renaming it would be a destructive migration for zero user-visible gain; @map lets the code
  /// say what the field means without touching the database.
  businessName String @map("restaurantName")
  ownerName      String?
  cellPhone      String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  country        String  @default("US") // "US" or "CA" — drives address format, time zones, distance units
  zip            String?
  timeZone       String  @default("America/New_York")
  cuisineType    String?
  priceRange     String? // "$" | "$$" | "$$$" | "$$$$"

  // Integrations (filled in later phases)
  twilioNumber                  String?            @unique
  twilioNumberSid               String?
  retellAgentId                 String?
  retellLlmId                   String?
  stripeCustomerId              String?            @unique
  stripeSubscriptionId          String?
  subscriptionStatus            SubscriptionStatus @default(none)
  // Mirrored from Stripe by the webhook (src/app/api/stripe/webhook) and the explicit "Refresh status" action.
  subscriptionCurrentPeriodEnd  DateTime?
  subscriptionCancelAtPeriodEnd Boolean            @default(false)
  setupFeePaidAt                DateTime?

  // Voice + greeting
  voiceId  String  @default("11labs-Adrian")
  greeting String?
  hostName String  @default("Alex")

  // Policies
  canQuotePrices       Boolean  @default(true)
  largePartyThreshold  Int      @default(8)
  largePartyDepositFee Decimal? @db.Decimal(10, 2)
  escalatesToManager   Boolean  @default(false)
  escalationTypes      String[] @default([])

  // Reservation book
  tableTurnMinutes           Int  @default(90)
  reservationIntervalMinutes Int  @default(30)
  maxCoversPerSlot           Int?
  seatingCapacity            Int?

  // Takeout + delivery (restaurant), and the SERVICE AREA for field_service verticals.
  //
  // One postcode and one radius, serving both: "a postcode and a radius in miles around the
  // business" is the same quantity whether it bounds where a kitchen delivers or how far a plumber
  // will drive, and the distance maths, the Canadian kilometre display and the geocoding fallbacks
  // already operate on them. The columns keep their delivery-era names — @map carries the neutral
  // field names without a destructive migration.
  takesTakeoutOrders     Boolean  @default(true)
  offersDelivery         Boolean  @default(false)
  serviceAreaZip         String?  @map("deliveryZip")
  serviceAreaRadiusMiles Decimal? @db.Decimal(5, 1) @map("deliveryRadiusMiles")

  // Field service
  /// Who turns up. Spoken by the agent ("Mike will call you within 15 minutes") and the default
  /// value for Job.assignedTo.
  technicianName   String?
  /// Keys from the vertical's `emergencyTypes`, chosen in onboarding. Parallel to escalationTypes.
  emergencyTypes   String[] @default([])
  /// Call-out / dispatch fee in micro-units of the account's currency. Micros, not Decimal, because
  /// money that is only ever added up and displayed is safer as an integer.
  calloutFeeMicros BigInt?
  /// How long one job occupies the calendar. Restaurants use tableTurnMinutes; a trade's visit is
  /// a different shape and a different default (120).
  jobSlotMinutes   Int      @default(120)
  /// Cap on bookable jobs in a day, so a two-van shop is not sold twelve calls.
  maxJobsPerDay    Int?

  // Dispatch-first (locksmith, towing). A mode of field_service, not a separate archetype: the
  // caller's question is "how fast can you get here", not "which day suits you".
  //
  /// Whether this business books scheduled work at all. A tow truck usually does not; a locksmith
  /// often does both. False removes the scheduling tools from the agent entirely.
  takesScheduledWork     Boolean @default(true)
  /// The response window the agent may quote, in minutes. Quoted as a range and as an estimate,
  /// never as a promise — see the guardrails. Null means the agent quotes no time at all.
  responseTimeMinMinutes Int?
  responseTimeMaxMinutes Int?
  /// How long the owner has to acknowledge an urgent escalation before the caller is texted.
  /// Null falls back to the vertical's default (5 minutes dispatch-first, 10 otherwise).
  escalationAckMinutes   Int?
  /// What the caller is told when nobody acknowledged in time. Null uses the vertical's default.
  /// Editable because the honest sentence differs by trade, and because someone stranded at the
  /// roadside deserves a real answer rather than silence.
  unacknowledgedMessage  String?

  // Shop appointment (auto repair, veterinary). The customer comes to the business, so there is no
  // service area and nothing is dispatched; what there is instead is somewhere else to send people.
  //
  /// Who to point a caller at when their vehicle cannot be driven in. Optional: a shop without a
  /// towing partner says so rather than inventing one.
  towingPartnerName  String?
  towingPartnerPhone String?
  /// Where to send an animal in trouble when the clinic is shut. Required for a veterinary account
  /// in onboarding, because the alternative to having it is dead air on the worst call of the day.
  emergencyReferralPhone String?

  // Geocoded business location (delivery radius / service area)
  latitude       Float?
  longitude      Float?
  agentSyncedAt  DateTime?
  agentSyncError String?

  // App state
  lastSeenAt     DateTime?
  onboardingStep Int       @default(2) // next step to complete; 9 = finished
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  users               User[]
  notifications       Notification[]
  businessHours       BusinessHours[]
  managerAvailability ManagerAvailability[]
  menuItems           MenuItem[]
  reservations        Reservation[]
  takeoutOrders       TakeoutOrder[]
  calls               Call[]
  googleCalendar      GoogleCalendarConnection?
  smsMessages         SmsMessage[]
  customers           Customer[]
  jobs                Job[]
  serviceOfferings    ServiceOffering[]
  properties          Property[]
  vendors             Vendor[]
}

// ---------- Property management ----------

/// A building or site. The unit of "where", one level above the door someone knocks on.
model Property {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name    String
  address String?
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units Unit[]
  jobs  Job[]

  @@index([accountId, name])
}

/// A door. `label` is whatever the manager calls it - "3B", "Rear cottage", "Unit 12".
model Unit {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  label String
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants Tenant[]
  jobs    Job[]

  /// One "3B" per building. The import dedupes on this.
  @@unique([propertyId, label])
  @@index([propertyId])
}

/// Who lives behind a door.
///
/// Points at Customer rather than duplicating a name and a number, so the phone lookup that every
/// other vertical already does works here too and a tenant who moves between units keeps one
/// identity. Several tenants per unit is normal and allowed; a unit with none is a vacancy.
model Tenant {
  id     String @id @default(cuid())
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  leaseStart DateTime?
  leaseEnd   DateTime?

  /// Standing answers, so the agent does not have to ask them on every call. Both are on the
  /// tenancy rather than the work order because they are facts about the home, not the fault.
  permissionToEnter Boolean @default(false)
  petOnPremises     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitId, customerId])
  @@index([customerId])
  @@index([unitId])
}

/// Someone the manager sends out. Deliberately thin: a name, a trade and a number is what a work
/// order needs to name who is attending. No portal, no automated messaging.
model Vendor {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name  String
  trade String?
  phone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, name])
}

// ---------- People who call ----------

/// One row per caller per account, shared by every vertical.
///
/// The point is returning-caller recognition: the agent looks a caller up by the number they are
/// calling from and already knows their name, their address and what they called about last time.
/// Restaurants have never had this — Reservation and TakeoutOrder carry a name and phone inline —
/// so `Reservation.customerId` and `TakeoutOrder.customerId` are nullable and left unfilled here;
/// linking historic bookings is a data job, not a schema one.
///
/// `details` holds whatever the vertical's intakeSchema says belongs to the person rather than the
/// job: a gate code, a preferred technician, the unit they rent.
model Customer {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name    String
  /// E.164. The lookup key, and why (accountId, phone) is unique.
  phone   String
  address String?
  notes   String?
  details Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations  Reservation[]
  takeoutOrders TakeoutOrder[]
  tenancies     Tenant[]
  jobs          Job[]

  @@unique([accountId, phone])
  @@index([accountId, name])
}

// ---------- Work (every non-restaurant vertical) ----------

/// What kind of work a Job is. The archetype decides which kinds it uses:
/// field_service books `service_call` (and `estimate` for roofing, `dispatch` for locksmith/towing),
/// shop_appointment books `shop_visit`, property_management raises `work_order`.
enum JobKind {
  service_call
  estimate
  dispatch
  shop_visit
  work_order
}

/// `requested` is what the AI creates when there is no slot to commit to; everything from
/// `scheduled` on is a human moving the job along. `dispatched` -> `en_route` -> `in_progress` is
/// the dispatch-first path, and a scheduled visit can jump straight to `in_progress`.
enum JobStatus {
  requested
  scheduled
  dispatched
  en_route
  in_progress
  completed
  cancelled
}

/// The booking record for every vertical that is not a restaurant.
///
/// Reservation and TakeoutOrder are left exactly as they are and keep serving restaurants; this is
/// the parallel shape for work that happens at an address (or on a vehicle, or in a unit) rather
/// than at a table. What varies per profession — the system type, the vehicle, the lock, the roof
/// section — lives in `details`, validated against the vertical's `intakeSchema` before it is
/// written. Anything queried is a real column; the rest stays JSON.
model Job {
  id         String    @id @default(cuid())
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  kind JobKind @default(service_call)

  /// Denormalised from Customer so a job still reads correctly if the customer row is removed,
  /// and so the AI can book before a Customer has been resolved.
  customerName  String
  customerPhone String?
  address       String?
  description   String?

  /// Set by the agent when the caller's situation matches the vertical's emergencyTypes. Drives the
  /// urgent notification, the outbound call to the owner and the acknowledgement sweep.
  isEmergency Boolean @default(false)

  scheduledStart DateTime? // UTC; null while status is `requested`
  scheduledEnd   DateTime? // UTC
  status         JobStatus    @default(requested)
  assignedTo     String?
  source         RecordSource @default(manual)

  details Json?

  /// Property management only; unused by the other archetypes.
  /// Where the work is, once property management knows. SetNull rather than Cascade: deleting a
  /// building must not erase the history of what was ever wrong with it.
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  unitId     String?
  unit       Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)

  googleEventId String?
  /// Why the last Google Calendar sync failed, cleared on success. Sync is best-effort — a Google
  /// outage must never block a booking — so failures land here and the escalation sweep retries them.
  googleSyncError String?

  smsConfirmedAt DateTime?
  cancelledAt    DateTime?
  cancelledBy    String? // "customer" (SMS reply) | "staff" | "ai"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]
  calls         Call[]

  @@index([accountId, scheduledStart])
  @@index([accountId, status])
  @@index([customerPhone])
  @@index([customerId])
}

/// What a trade, shop or clinic sells, and the equivalent of MenuItem for those verticals.
///
/// Deliberately NOT MenuItem: a menu item has a category, dietary tags and a price a caller can be
/// quoted outright, while a service has a "from" price that may only be an estimate. Sharing one
/// table would mean one of the two carrying columns that never apply to it.
model ServiceOffering {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name     String
  category String?
  enabled  Boolean @default(true)

  /// Starting price in micro-units. Null means "no published price".
  priceFromMicros BigInt?
  /// Whether the agent may say the price out loud, per service. The account-wide switch is
  /// `canQuotePrices`; this narrows it.
  canQuote        Boolean @default(false)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, sortOrder])
}

// ---------- Stripe webhook idempotency ----------

/// Every Stripe event id we've processed. Stripe may deliver an event more than once; a redelivery is
/// acknowledged (2xx) without re-running side effects.
model StripeEvent {
  id          String   @id // Stripe event id (evt_...)
  type        String
  processedAt DateTime @default(now())
}

// ---------- Notifications (in-app) ----------

enum NotificationType {
  reservation
  takeout
  waitlist
  /// A field-service booking. Added in 2b; before it, these borrowed `reservation` and were told
  /// apart by Notification.jobId, which the UI then had to paper over when labelling them.
  job
  message
  escalation
  missed_call
  system
}

enum NotificationPriority {
  normal
  urgent
}

model Notification {
  id             String               @id @default(cuid())
  accountId      String
  account        Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type           NotificationType
  priority       NotificationPriority @default(normal)
  title          String
  body           String
  reservationId  String?
  reservation    Reservation?         @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  jobId          String?
  job            Job?                 @relation(fields: [jobId], references: [id], onDelete: SetNull)
  takeoutOrderId String?
  takeoutOrder   TakeoutOrder?        @relation(fields: [takeoutOrderId], references: [id], onDelete: SetNull)
  callId         String?
  call           Call?                @relation(fields: [callId], references: [id], onDelete: SetNull)
  readAt         DateTime?
  acknowledgedAt DateTime?
  followUpSentAt DateTime? // escalation: guest was texted after the acknowledge window lapsed
  createdAt      DateTime             @default(now())

  @@index([accountId, readAt])
  @@index([accountId, createdAt])
}

// ---------- Hours ----------

model BusinessHours {
  id         String  @id @default(cuid())
  accountId  String
  account    Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0 = Sunday ... 6 = Saturday
  periodName String // "Lunch", "Dinner", "All day"
  open       String // "HH:MM" 24h, restaurant local time
  close      String // "HH:MM" 24h, restaurant local time
  isClosed   Boolean @default(false)
  sortOrder  Int     @default(0)

  @@index([accountId, dayOfWeek])
}

model ManagerAvailability {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  start     String // "HH:MM"
  end       String // "HH:MM"

  @@index([accountId, dayOfWeek])
}

// ---------- Menu ----------

model MenuItem {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  category    String?
  price       Decimal? @db.Decimal(10, 2)
  description String?
  dietaryTags String[] @default([])
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId])
}

// ---------- Reservations ----------

enum ReservationStatus {
  booked
  confirmed
  seated
  completed
  cancelled
  no_show
}

enum RecordSource {
  ai
  manual
}

model Reservation {
  id                String            @id @default(cuid())
  accountId         String
  account           Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Nullable and unfilled for now: existing reservations are not backfilled onto Customer.
  customerId        String?
  customer          Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  guestName         String
  guestPhone        String?
  partySize         Int
  seatingPreference String?
  specialRequests   String?
  startTime         DateTime // UTC
  endTime           DateTime // UTC
  status            ReservationStatus @default(booked)
  isWaitlist        Boolean           @default(false)
  source            RecordSource      @default(manual)
  googleEventId     String?
  smsConfirmedAt    DateTime? // guest confirmation text sent
  cancelledAt       DateTime?
  cancelledBy       String? // "guest" (SMS reply) | "staff" | "ai"
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  notifications Notification[]
  calls         Call[]

  @@index([accountId, startTime])
  @@index([accountId, status])
  @@index([customerId])
}

// ---------- Takeout ----------

enum TakeoutStatus {
  new
  confirmed
  ready
  picked_up
  cancelled
}

model TakeoutOrder {
  id              String        @id @default(cuid())
  accountId       String
  account         Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Nullable and unfilled for now: existing orders are not backfilled onto Customer.
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  guestName       String
  guestPhone      String?
  items           String // free text, as dictated by the caller
  notes           String?
  pickupTime      DateTime // UTC
  isDelivery      Boolean       @default(false)
  deliveryAddress String?
  status          TakeoutStatus @default(new)
  source          RecordSource  @default(manual)
  smsConfirmedAt  DateTime? // guest confirmation text sent
  cancelledAt     DateTime?
  cancelledBy     String? // "guest" (SMS reply) | "staff" | "ai"
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  notifications Notification[]
  calls         Call[]

  @@index([accountId, pickupTime])
  @@index([accountId, status])
  @@index([customerId])
}

// ---------- Calls ----------

enum CallClassification {
  reservation
  takeout
  question
  waitlist
  /// Field service. `emergency` is deliberately distinct from `escalation`: one means someone is
  /// in trouble right now, the other means a human is needed.
  service_call
  emergency
  estimate
  message
  escalation
  missed
  other
}

model Call {
  id                  String             @id @default(cuid())
  accountId           String
  account             Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  twilioCallSid       String?            @unique
  retellCallId        String?            @unique
  callerPhone         String?
  callerName          String?
  direction           String             @default("inbound")
  callStatus          String             @default("ongoing") // registered | ongoing | ended | error
  isTest              Boolean            @default(false)
  startedAt           DateTime
  endedAt             DateTime?
  duration            Int? // seconds
  classification      CallClassification @default(other)
  recordingUrl        String?
  publicLogUrl        String?
  transcript          String?
  summary             String?
  sentiment           String? // Positive | Neutral | Negative | Unknown
  disconnectionReason String?
  messageText         String? // message left for the restaurant (take_message)
  escalationReason    String? // set when the AI escalated to a manager
  callbackRequested   Boolean            @default(false)
  notifiedAt          DateTime? // outcome notification created (idempotency for webhook retries)
  managerCallSid      String? // outbound Twilio call placed to the manager for an escalation
  managerCalledAt     DateTime?
  reservationId       String?
  reservation         Reservation?       @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  jobId               String?
  job                 Job?               @relation(fields: [jobId], references: [id], onDelete: SetNull)
  takeoutOrderId      String?
  takeoutOrder        TakeoutOrder?      @relation(fields: [takeoutOrderId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())

  notifications Notification[]

  @@index([accountId, startedAt])
}

// ---------- Google Calendar (Phase 5) ----------

model GoogleCalendarConnection {
  id           String    @id @default(cuid())
  accountId    String    @unique
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  calendarId   String    @default("primary")
  calendarName String?
  email        String? // Google account the calendar belongs to
  scope        String?
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ---------- SMS log ----------

/// Every SMS we send or receive, with the segment count Twilio actually billed.
///
/// SMS is billed per SEGMENT, not per message: 160 GSM-7 characters per segment, or 70 if the
/// body contains any non-GSM character. Without this table the segment count has to be guessed
/// by re-rendering the templates elsewhere, which silently goes wrong the moment the copy
/// changes. Twilio returns `num_segments` on every send, so we store what was actually billed.
///
/// Written by src/lib/sms.ts and the inbound webhook. Read by the ops dashboard for costing.
model SmsMessage {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Twilio Message SID (SM...). The join key for billing reconciliation.
  ///
  /// A send that never reached Twilio has no SID, so a failure is stored under a synthetic
  /// `failed:<uuid>` key with numSegments 0. Billing sums segments, so those rows cost nothing and
  /// are still there to be read — a message we failed to send is a fact about the account, not an
  /// absence.
  messageSid String  @unique
  direction  String // "outbound" | "inbound"
  toNumber   String
  fromNumber String?

  /// Twilio's own count. This is what gets billed — never recompute it.
  numSegments Int
  /// "GSM-7" | "UCS-2", as reported by Twilio. Spots encoding regressions in the templates.
  encoding    String?
  status      String?

  /// What the message was for: "reservation_confirmation" | "takeout_confirmation" |
  /// "escalation_followup" | "cancellation_reply" | "inbound_reply"
  purpose String?

  /// Why a send failed, verbatim from Twilio. Null for anything that actually went out.
  error String?

  /// Loose links: no FK, so a deleted booking never blocks the cost record.
  callId        String?
  reservationId String?
  jobId         String?

  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([messageSid])
  @@index([jobId])
}
