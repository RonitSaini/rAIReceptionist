// FrontDesk AI — Prisma schema
// All DateTime columns are stored in UTC. Display in Account.timeZone.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (-pooler) for the app
  directUrl = env("DIRECT_URL") // unpooled, used by prisma db push / migrate
}

// ---------- Auth ----------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String? // null for Google-only users
  googleId      String?   @unique
  emailVerified DateTime?
  image         String?
  accountId     String?
  account       Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([accountId])
}

// ---------- Business account ----------

enum SubscriptionStatus {
  none
  trialing
  active
  past_due
  cancelled
}

/// The profession an account answers the phone for. Every value maps to exactly one archetype
/// in src/verticals: restaurant; field_service (plumbing, hvac, electrical, roofing, locksmith,
/// towing); shop_appointment (auto_repair, veterinary); property_management.
///
/// Chosen at sign-up and locked once onboarding step 2 is complete: the data shapes differ per
/// archetype and switching would orphan an account's bookings. Only an admin path may change it.
enum Vertical {
  restaurant
  plumbing
  hvac
  electrical
  roofing
  locksmith
  towing
  auto_repair
  veterinary
  property_management
}

model Account {
  id String @id @default(cuid())

  /// Which profession this account is. Drives vocabulary, onboarding steps, dashboard modules,
  /// the agent's prompt and functions — see src/verticals. Existing rows were backfilled to
  /// `restaurant`, which is also the default so a row can never exist without one.
  vertical Vertical @default(restaurant)

  /// The trading name. Column name predates the move beyond restaurants; it holds the business
  /// name for every vertical and is deliberately NOT renamed (renaming it would be a destructive
  /// migration for zero user-visible gain).
  restaurantName String
  ownerName      String?
  cellPhone      String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  country        String  @default("US") // "US" or "CA" — drives address format, time zones, distance units
  zip            String?
  timeZone       String  @default("America/New_York")
  cuisineType    String?
  priceRange     String? // "$" | "$$" | "$$$" | "$$$$"

  // Integrations (filled in later phases)
  twilioNumber                  String?            @unique
  twilioNumberSid               String?
  retellAgentId                 String?
  retellLlmId                   String?
  stripeCustomerId              String?            @unique
  stripeSubscriptionId          String?
  subscriptionStatus            SubscriptionStatus @default(none)
  // Mirrored from Stripe by the webhook (src/app/api/stripe/webhook) and the explicit "Refresh status" action.
  subscriptionCurrentPeriodEnd  DateTime?
  subscriptionCancelAtPeriodEnd Boolean            @default(false)
  setupFeePaidAt                DateTime?

  // Voice + greeting
  voiceId  String  @default("11labs-Adrian")
  greeting String?
  hostName String  @default("Alex")

  // Policies
  canQuotePrices       Boolean  @default(true)
  largePartyThreshold  Int      @default(8)
  largePartyDepositFee Decimal? @db.Decimal(10, 2)
  escalatesToManager   Boolean  @default(false)
  escalationTypes      String[] @default([])

  // Reservation book
  tableTurnMinutes           Int  @default(90)
  reservationIntervalMinutes Int  @default(30)
  maxCoversPerSlot           Int?
  seatingCapacity            Int?

  // Takeout + delivery
  takesTakeoutOrders  Boolean  @default(true)
  offersDelivery      Boolean  @default(false)
  deliveryZip         String?
  deliveryRadiusMiles Decimal? @db.Decimal(5, 1)

  // Geocoded restaurant location (for delivery-radius checks)
  latitude       Float?
  longitude      Float?
  agentSyncedAt  DateTime?
  agentSyncError String?

  // App state
  lastSeenAt     DateTime?
  onboardingStep Int       @default(2) // next step to complete; 9 = finished
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  users               User[]
  notifications       Notification[]
  businessHours       BusinessHours[]
  managerAvailability ManagerAvailability[]
  menuItems           MenuItem[]
  reservations        Reservation[]
  takeoutOrders       TakeoutOrder[]
  calls               Call[]
  googleCalendar      GoogleCalendarConnection?
  smsMessages         SmsMessage[]
  customers           Customer[]
}

// ---------- People who call ----------

/// One row per caller per account, shared by every vertical.
///
/// The point is returning-caller recognition: the agent looks a caller up by the number they are
/// calling from and already knows their name, their address and what they called about last time.
/// Restaurants have never had this — Reservation and TakeoutOrder carry a name and phone inline —
/// so `Reservation.customerId` and `TakeoutOrder.customerId` are nullable and left unfilled here;
/// linking historic bookings is a data job, not a schema one.
///
/// `details` holds whatever the vertical's intakeSchema says belongs to the person rather than the
/// job: a gate code, a preferred technician, the unit they rent.
model Customer {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name    String
  /// E.164. The lookup key, and why (accountId, phone) is unique.
  phone   String
  address String?
  notes   String?
  details Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations  Reservation[]
  takeoutOrders TakeoutOrder[]

  @@unique([accountId, phone])
  @@index([accountId, name])
}

// ---------- Stripe webhook idempotency ----------

/// Every Stripe event id we've processed. Stripe may deliver an event more than once; a redelivery is
/// acknowledged (2xx) without re-running side effects.
model StripeEvent {
  id          String   @id // Stripe event id (evt_...)
  type        String
  processedAt DateTime @default(now())
}

// ---------- Notifications (in-app) ----------

enum NotificationType {
  reservation
  takeout
  waitlist
  message
  escalation
  missed_call
  system
}

enum NotificationPriority {
  normal
  urgent
}

model Notification {
  id             String               @id @default(cuid())
  accountId      String
  account        Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type           NotificationType
  priority       NotificationPriority @default(normal)
  title          String
  body           String
  reservationId  String?
  reservation    Reservation?         @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  takeoutOrderId String?
  takeoutOrder   TakeoutOrder?        @relation(fields: [takeoutOrderId], references: [id], onDelete: SetNull)
  callId         String?
  call           Call?                @relation(fields: [callId], references: [id], onDelete: SetNull)
  readAt         DateTime?
  acknowledgedAt DateTime?
  followUpSentAt DateTime? // escalation: guest was texted after the acknowledge window lapsed
  createdAt      DateTime             @default(now())

  @@index([accountId, readAt])
  @@index([accountId, createdAt])
}

// ---------- Hours ----------

model BusinessHours {
  id         String  @id @default(cuid())
  accountId  String
  account    Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0 = Sunday ... 6 = Saturday
  periodName String // "Lunch", "Dinner", "All day"
  open       String // "HH:MM" 24h, restaurant local time
  close      String // "HH:MM" 24h, restaurant local time
  isClosed   Boolean @default(false)
  sortOrder  Int     @default(0)

  @@index([accountId, dayOfWeek])
}

model ManagerAvailability {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  start     String // "HH:MM"
  end       String // "HH:MM"

  @@index([accountId, dayOfWeek])
}

// ---------- Menu ----------

model MenuItem {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  category    String?
  price       Decimal? @db.Decimal(10, 2)
  description String?
  dietaryTags String[] @default([])
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId])
}

// ---------- Reservations ----------

enum ReservationStatus {
  booked
  confirmed
  seated
  completed
  cancelled
  no_show
}

enum RecordSource {
  ai
  manual
}

model Reservation {
  id                String            @id @default(cuid())
  accountId         String
  account           Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Nullable and unfilled for now: existing reservations are not backfilled onto Customer.
  customerId        String?
  customer          Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  guestName         String
  guestPhone        String?
  partySize         Int
  seatingPreference String?
  specialRequests   String?
  startTime         DateTime // UTC
  endTime           DateTime // UTC
  status            ReservationStatus @default(booked)
  isWaitlist        Boolean           @default(false)
  source            RecordSource      @default(manual)
  googleEventId     String?
  smsConfirmedAt    DateTime? // guest confirmation text sent
  cancelledAt       DateTime?
  cancelledBy       String? // "guest" (SMS reply) | "staff" | "ai"
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  notifications Notification[]
  calls         Call[]

  @@index([accountId, startTime])
  @@index([accountId, status])
  @@index([customerId])
}

// ---------- Takeout ----------

enum TakeoutStatus {
  new
  confirmed
  ready
  picked_up
  cancelled
}

model TakeoutOrder {
  id              String        @id @default(cuid())
  accountId       String
  account         Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Nullable and unfilled for now: existing orders are not backfilled onto Customer.
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  guestName       String
  guestPhone      String?
  items           String // free text, as dictated by the caller
  notes           String?
  pickupTime      DateTime // UTC
  isDelivery      Boolean       @default(false)
  deliveryAddress String?
  status          TakeoutStatus @default(new)
  source          RecordSource  @default(manual)
  smsConfirmedAt  DateTime? // guest confirmation text sent
  cancelledAt     DateTime?
  cancelledBy     String? // "guest" (SMS reply) | "staff" | "ai"
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  notifications Notification[]
  calls         Call[]

  @@index([accountId, pickupTime])
  @@index([accountId, status])
  @@index([customerId])
}

// ---------- Calls ----------

enum CallClassification {
  reservation
  takeout
  question
  waitlist
  message
  escalation
  missed
  other
}

model Call {
  id                  String             @id @default(cuid())
  accountId           String
  account             Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  twilioCallSid       String?            @unique
  retellCallId        String?            @unique
  callerPhone         String?
  callerName          String?
  direction           String             @default("inbound")
  callStatus          String             @default("ongoing") // registered | ongoing | ended | error
  isTest              Boolean            @default(false)
  startedAt           DateTime
  endedAt             DateTime?
  duration            Int? // seconds
  classification      CallClassification @default(other)
  recordingUrl        String?
  publicLogUrl        String?
  transcript          String?
  summary             String?
  sentiment           String? // Positive | Neutral | Negative | Unknown
  disconnectionReason String?
  messageText         String? // message left for the restaurant (take_message)
  escalationReason    String? // set when the AI escalated to a manager
  callbackRequested   Boolean            @default(false)
  notifiedAt          DateTime? // outcome notification created (idempotency for webhook retries)
  managerCallSid      String? // outbound Twilio call placed to the manager for an escalation
  managerCalledAt     DateTime?
  reservationId       String?
  reservation         Reservation?       @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  takeoutOrderId      String?
  takeoutOrder        TakeoutOrder?      @relation(fields: [takeoutOrderId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())

  notifications Notification[]

  @@index([accountId, startedAt])
}

// ---------- Google Calendar (Phase 5) ----------

model GoogleCalendarConnection {
  id           String    @id @default(cuid())
  accountId    String    @unique
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  calendarId   String    @default("primary")
  calendarName String?
  email        String? // Google account the calendar belongs to
  scope        String?
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ---------- SMS log ----------

/// Every SMS we send or receive, with the segment count Twilio actually billed.
///
/// SMS is billed per SEGMENT, not per message: 160 GSM-7 characters per segment, or 70 if the
/// body contains any non-GSM character. Without this table the segment count has to be guessed
/// by re-rendering the templates elsewhere, which silently goes wrong the moment the copy
/// changes. Twilio returns `num_segments` on every send, so we store what was actually billed.
///
/// Written by src/lib/sms.ts and the inbound webhook. Read by the ops dashboard for costing.
model SmsMessage {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Twilio Message SID (SM...). The join key for billing reconciliation.
  messageSid String  @unique
  direction  String // "outbound" | "inbound"
  toNumber   String
  fromNumber String?

  /// Twilio's own count. This is what gets billed — never recompute it.
  numSegments Int
  /// "GSM-7" | "UCS-2", as reported by Twilio. Spots encoding regressions in the templates.
  encoding    String?
  status      String?

  /// What the message was for: "reservation_confirmation" | "takeout_confirmation" |
  /// "escalation_followup" | "cancellation_reply" | "inbound_reply"
  purpose String?

  /// Loose links: no FK, so a deleted booking never blocks the cost record.
  callId        String?
  reservationId String?

  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([messageSid])
}
