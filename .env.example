# ============================================================
# CallCover — environment variables
# Copy to .env and fill in. Never commit .env.
#
# PHASE 1 needs only DATABASE_URL + NEXTAUTH_SECRET (+ NEXTAUTH_URL locally).
# Everything else is listed now so you can collect keys before later phases.
# ============================================================

# ---------- Phase 1: Database (Neon Postgres — see README) ----------
# Neon gives you a pooled URL (for the app) and a direct URL (for migrations).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Optional: unpooled/direct connection used by `prisma migrate`. Same as DATABASE_URL if you only have one.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ---------- Phase 1: Auth (NextAuth) ----------
# Generate with PowerShell:  [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Local dev URL. On Vercel this is set automatically; leave it out there.
NEXTAUTH_URL="http://localhost:3000"

# Google sign-in (optional in Phase 1 — the button only appears when both are set).
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google  (and your Vercel URL)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public base URL of the app (used in SMS links and webhook URLs in later phases)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------- Phase 2: Retell AI (voice agent) ----------
# Retell dashboard -> API Keys. Webhooks are verified with this same key (x-retell-signature).
RETELL_API_KEY=""
# Optional: shared secret sent as the x-callcover-secret header on custom-function calls.
# If blank, one is derived from RETELL_API_KEY.
RETELL_FUNCTION_SECRET=""
# Optional overrides
RETELL_LLM_MODEL="gpt-4.1"
RETELL_SIP_DOMAIN="sip.retellai.com"

# ---------- Phase 2/3: Twilio (phone numbers + guest SMS only) ----------
# Twilio console -> Account Info
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Messaging Service SID used for guest-facing SMS (confirmations, reply-to-cancel) — Phase 3
TWILIO_MESSAGING_SERVICE_SID=""
# Optional: default area code to search when provisioning a number (e.g. 212). Falls back to the owner's cell area code.
TWILIO_DEFAULT_AREA_CODE=""

# Local development only (never in production): skip Twilio/Retell webhook signature checks,
# e.g. when your tunnel rewrites the URL Twilio signed.
SKIP_WEBHOOK_SIGNATURE_VALIDATION="false"

# ---------- Phase 3: Escalation timing ----------
# Minutes before an unacknowledged escalation triggers the "manager will call back" SMS to the guest
ESCALATION_ACK_TIMEOUT_MINUTES="10"
# Secret for the scheduled job (Vercel Cron) that checks unacknowledged escalations
CRON_SECRET=""

# ---------- Phase 4: Stripe (setup fee + subscription) ----------
# Prefer a restricted key (rk_...) over the account secret key: Customers, Checkout Sessions, Subscriptions,
# Invoices, Customer portal → write, Prices → read, everything else → none. Never commit a real key; on Vercel
# store it as a *sensitive* environment variable.
STRIPE_SECRET_KEY=""
# Not used by hosted Checkout — reserved for a future embedded (Stripe.js) form.
STRIPE_PUBLISHABLE_KEY=""
# Signing secret of the webhook endpoint https://<app>/api/stripe/webhook (or the one `stripe listen` prints locally)
STRIPE_WEBHOOK_SECRET=""
# Price IDs from the Stripe dashboard (Product catalog → product → price). The setup fee is optional.
STRIPE_PRICE_SETUP_FEE=""
STRIPE_PRICE_MONTHLY=""
# "true" = the AI host stops answering calls for accounts without an active subscription. Leave empty in dev.
BILLING_REQUIRED=""

# ---------- Phase 5: Google Calendar sync ----------
# Can reuse GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above if the same OAuth client has the Calendar scope enabled.
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
# Redirect URI registered in Google Cloud: http://localhost:3000/api/google-calendar/callback
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/api/google-calendar/callback"
# Random string used to encrypt stored OAuth tokens at rest
TOKEN_ENCRYPTION_KEY=""
