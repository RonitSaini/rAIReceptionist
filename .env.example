# ============================================================
# FrontDesk AI — environment variables
# Copy to .env and fill in. Never commit .env.
#
# PHASE 1 needs only DATABASE_URL + NEXTAUTH_SECRET (+ NEXTAUTH_URL locally).
# Everything else is listed now so you can collect keys before later phases.
# ============================================================

# ---------- Phase 1: Database (Neon Postgres — see README) ----------
# Neon gives you a pooled URL (for the app) and a direct URL (for migrations).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Optional: unpooled/direct connection used by `prisma migrate`. Same as DATABASE_URL if you only have one.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ---------- Phase 1: Auth (NextAuth) ----------
# Generate with PowerShell:  [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Local dev URL. On Vercel this is set automatically; leave it out there.
NEXTAUTH_URL="http://localhost:3000"

# Google sign-in (optional in Phase 1 — the button only appears when both are set).
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google  (and your Vercel URL)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public base URL of the app (used in SMS links and webhook URLs in later phases)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------- Phase 2: Retell AI (voice agent) ----------
# Retell dashboard -> API Keys. Webhooks are verified with this same key (x-retell-signature).
RETELL_API_KEY=""
# Optional: shared secret sent as the x-frontdesk-secret header on custom-function calls.
# If blank, one is derived from RETELL_API_KEY.
RETELL_FUNCTION_SECRET=""
# Optional overrides
RETELL_LLM_MODEL="gpt-4.1"
# Must be a bare retellai.com hostname. Anything else is refused at dial time and the built-in
# sip.retellai.com is used instead (loudly - grep the logs for "[retell] REFUSED").
RETELL_SIP_DOMAIN="sip.retellai.com"

# ---------- Phase 2/3: Twilio (phone numbers + guest SMS only) ----------
# Twilio console -> Account Info
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# The ONE Messaging Service under the registered A2P 10DLC brand (docs/frontdesk-sms-spec.md §7). Every provisioned
# customer number is added to its sender pool, and every text goes out through it FROM the customer's own number.
# Without it texts leave from raw numbers, which US carriers filter as unregistered - the app logs that it is doing so.
TWILIO_MESSAGING_SERVICE_SID=""
# Optional: default area code to search when provisioning a number (e.g. 212). Falls back to the owner's cell area code.
TWILIO_DEFAULT_AREA_CODE=""

# Local development only (never in production): skip Twilio/Retell webhook signature checks,
# e.g. when your tunnel rewrites the URL Twilio signed.
SKIP_WEBHOOK_SIGNATURE_VALIDATION="false"

# ---------- Phase 3: Escalations + guest SMS ----------
# Minutes before an unacknowledged escalation triggers the "manager will call back when we open" SMS to the guest
ESCALATION_ACK_TIMEOUT_MINUTES="10"
# Secret for the scheduled sweep (vercel.json cron -> /api/cron/escalations). Vercel sends it as a Bearer token.
CRON_SECRET=""
# Guest texts go out from the restaurant's Twilio number, or from TWILIO_MESSAGING_SERVICE_SID when set (above).
# US carriers require A2P 10DLC registration (brand + campaign in the Twilio Console) for application SMS;
# trial accounts can only text verified numbers.

# ---------- Email (Resend — welcome email on sign-up) ----------
# resend.com -> API Keys. Without a key, welcome emails are silently skipped.
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend. The default (onboarding@resend.dev) is
# Resend's test sender: it only delivers to the Resend account's own email.
RESEND_FROM="FrontDesk AI <onboarding@resend.dev>"
# Where a customer's reply lands (any real inbox works — it need not be on the verified domain).
RESEND_REPLY_TO=""
# Outside production (VERCEL_ENV != "production": every laptop, every preview, a local `next start`) EVERY
# outbound email is redirected here, with the real recipient written into the subject. Unset = nothing is sent
# outside production at all. Only production talks to real people. Set it to your own inbox.
DEV_EMAIL_INBOX=""

# ---------- Phase 4: Stripe (setup fee + subscription) ----------
# Prefer a restricted key (rk_...) over the account secret key: Customers, Checkout Sessions, Subscriptions,
# Invoices, Customer portal → write, Prices → read, everything else → none. Never commit a real key; on Vercel
# store it as a *sensitive* environment variable.
STRIPE_SECRET_KEY=""
# Not used by hosted Checkout — reserved for a future embedded (Stripe.js) form.
STRIPE_PUBLISHABLE_KEY=""
# Signing secret of the webhook endpoint https://<app>/api/stripe/webhook (or the one `stripe listen` prints locally).
# Locally this may be any throwaway value: HMAC verification behaves the same with any secret, and
# tests/stripe-webhook.test.mjs signs with whatever is set here. The real one belongs on Vercel only.
STRIPE_WEBHOOK_SECRET=""
# Price IDs from the Stripe dashboard (Product catalog → product → price). The setup fee is optional.
STRIPE_PRICE_SETUP_FEE=""
STRIPE_PRICE_MONTHLY=""
# "true" = billing is enforced (docs/frontdesk-billing-spec.md): a failed payment starts a 10-day grace, then the AI
# answers but books nothing, and 30 days after a subscription ends the number is released. The AI ANSWERS in every
# state - this never makes it stop picking up. Accounts with Account.isInternal are exempt. Leave empty in dev.
BILLING_REQUIRED=""
# Opposite polarity to the line above, on purpose: a phone number is only issued to an account with an
# active subscription UNLESS this says "false". A number rents real dollars every month, so a forgotten
# variable must not be what hands one out. Leave empty (or unset) to enforce; it is skipped anyway
# wherever STRIPE_SECRET_KEY is absent, so local dev without Stripe is unaffected.
PHONE_REQUIRES_SUBSCRIPTION=""

# ---------- Phase 5: Google Calendar sync ----------
# Uses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above (one OAuth client serves both Google sign-in and
# Calendar). Register BOTH redirect URIs on that client:
#   <app url>/api/auth/callback/google          (sign-in)
#   <app url>/api/google-calendar/callback      (calendar)
# and enable the "Google Calendar API" for the project. Override the client only if you want a separate one:
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
# Optional override; defaults to NEXT_PUBLIC_APP_URL + /api/google-calendar/callback
GOOGLE_CALENDAR_REDIRECT_URI=""
# Random string used to encrypt stored OAuth tokens at rest (falls back to NEXTAUTH_SECRET — set it so rotating
# NEXTAUTH_SECRET never locks you out of stored calendar tokens)
TOKEN_ENCRYPTION_KEY=""

# ---------- Google Maps Platform (address suggestions + delivery-area map) ----------
# Same Google Cloud project as the OAuth client. Enable "Places API (New)", "Geocoding API" and
# "Maps JavaScript API", then create TWO keys under APIs & Services -> Credentials:
#   1. Server key (restrict to Places API (New) + Geocoding API). Never exposed to browsers.
GOOGLE_MAPS_API_KEY=""
#   2. Browser key (restrict to Maps JavaScript API + your site URLs under "Website restrictions").
#      Draws the delivery-radius map in the Menu & policies step. Optional — without it the radius still
#      works, you just don't see it on a map.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""
# Without GOOGLE_MAPS_API_KEY the address form has no suggestions and delivery checks use the free
# US Census geocoder instead.
